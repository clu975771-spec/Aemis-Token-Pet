<Window x:Class="AemisTokenPet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="252" Height="280" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" MouseLeftButtonDown="WindowDrag">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="爱弥斯 · 角色工作台">
        <MenuItem Header="选择人物预设"><MenuItem Header="爱弥斯 · 默认" Click="UseDefaultPreset"/><MenuItem Header="添加自定义人物预设…" Click="SavePreset"/></MenuItem>
        <MenuItem Header="导入人物预设包…" Click="ImportPresetPack"/>
        <MenuItem Header="导出当前人物预设包…" Click="ExportPresetPack"/>
        <Separator/>
        <MenuItem Header="更换透明 PNG 人物…" Click="ChooseMascot"/>
        <MenuItem Header="聊天框颜色…" Click="ChooseColor"/>
        <MenuItem Header="连点台词…" Click="ChoosePatMessage"/>
        <MenuItem Header="点击音效" IsCheckable="True" IsChecked="True" Click="ToggleSound"/>
        <MenuItem Header="音效类型"><MenuItem Header="低沉咚咚" Tag="basso" Click="SetSound"/><MenuItem Header="清脆啵啵" Tag="pop" Click="SetSound"/><MenuItem Header="活泼噗噗" Tag="funk" Click="SetSound"/><MenuItem Header="轻吹呼呼" Tag="blow" Click="SetSound"/><MenuItem Header="玻璃叮咚" Tag="bottle" Click="SetSound"/><MenuItem Header="小青蛙" Tag="frog" Click="SetSound"/><Separator/><MenuItem Header="导入 15 秒以内音效…" Click="ChooseSound"/></MenuItem>
        <MenuItem x:Name="MascotSizeMenu" Header="人物大小 100%"><Slider Minimum="0.6" Maximum="1.5" Value="1" ValueChanged="MascotSizeChanged" Width="150"/></MenuItem>
        <MenuItem x:Name="BubbleSizeMenu" Header="聊天框大小 100%"><Slider Minimum="0.6" Maximum="1.5" Value="1" ValueChanged="BubbleSizeChanged" Width="150"/></MenuItem>
        <MenuItem x:Name="OpacityMenu" Header="气泡透明度 97%"><Slider Minimum="0.35" Maximum="1" Value="0.97" ValueChanged="OpacityChanged" Width="150"/></MenuItem>
        <MenuItem Header="记住当前位置" Click="RememberPosition"/>
        <MenuItem Header="退出" Click="Quit"/>
      </MenuItem>
    </ContextMenu>
  </Window.ContextMenu>
  <Grid x:Name="Root" Margin="5">
    <Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="Bubble" Grid.Row="0" CornerRadius="22" Background="#F9E5EC" BorderBrush="#D75C8A" BorderThickness="2" Opacity="0.97">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="Caption" Text="Windows Token Pet" FontSize="13" FontWeight="SemiBold" Foreground="#B0436D" HorizontalAlignment="Center"/>
        <TextBlock x:Name="MainText" Text="爱弥斯" FontSize="29" FontWeight="Bold" Foreground="#D14D7C" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Detail" Text="点击人物互动" FontSize="11" Foreground="#20AAB7" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
    <Image x:Name="Mascot" Grid.Row="1" Source="Assets/Aemis.png" Stretch="Uniform" MouseLeftButtonDown="MascotClicked" RenderTransformOrigin="0.5,0.5"/>
  </Grid>
</Window>
